# -----------------------------------------------------------------
# RecoverPulse AI -- Server Environment Variables
# Copy this file to .env and fill in your real values
# -----------------------------------------------------------------

# -- App --
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# -- MongoDB Atlas --
# Get from: https://cloud.mongodb.com -> Clusters -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/recoverpulse?retryWrites=true&w=majority

# -- Groq AI (Day 4) --
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -- Razorpay (Day 6) --
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
# Get from: https://dashboard.razorpay.com/app/webhooks (set when adding webhook URL)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# -- Twilio WhatsApp (Day 7) --
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# -- Resend Email (Day 8) --
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
